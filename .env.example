# Sync AP <- SHZ360 (tarik PO & Terima PO untuk staging)
# Token harus sama persis dengan IRON_INTEGRATION_TOKEN di .env public_html (SHZ360).
SHZ360_BASE_URL=
SHZ360_INTEGRATION_TOKEN=
SHZ360_TIMEOUT=

# Jeda antar pengiriman (ms) saat kirim email Invoice/OB ke klien AR (batch),
# supaya tidak melewati rate limit per-detik provider SMTP (mis. Mailtrap
# sandbox). Naikkan kalau provider masih membatasi lebih ketat dari default.
EMAIL_BLAST_DELAY_MS=1000

# Laravel Reverb (WebSocket server untuk lonceng notifikasi realtime).
# REVERB_HOST/PORT/SCHEME = alamat publik yang dipakai client (FE) untuk connect,
# biasanya di-proxy lewat domain BE yang sama (lihat SANCTUM_STATEFUL_DOMAINS) via
# reverse proxy websocket (mod_proxy_wstunnel dsb) ke REVERB_SERVER_HOST/PORT tempat
# proses `php artisan reverb:start` benar-benar listen. Wajib proses terpisah & persisten
# di hosting (bukan proses yang dimatikan tiap request seperti PHP-FPM biasa).
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=api.iron.shezaerp.net
REVERB_PORT=443
REVERB_SCHEME=https

REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080

# Sync AP <- SHZ360 (tarik PO & Terima PO untuk staging)
# Token harus sama persis dengan IRON_INTEGRATION_TOKEN di .env public_html (SHZ360).
SHZ360_BASE_URL=
SHZ360_INTEGRATION_TOKEN=
SHZ360_TIMEOUT=

# Jeda antar pengiriman (ms) saat kirim email Invoice/OB ke klien AR (batch),
# supaya tidak melewati rate limit per-detik provider SMTP (mis. Mailtrap
# sandbox). Naikkan kalau provider masih membatasi lebih ketat dari default.
EMAIL_BLAST_DELAY_MS=1000

# Laravel Reverb (WebSocket server untuk lonceng notifikasi realtime).
# REVERB_HOST/PORT/SCHEME = alamat publik yang dipakai client (FE) untuk connect,
# biasanya di-proxy lewat domain BE yang sama (lihat SANCTUM_STATEFUL_DOMAINS) via
# reverse proxy websocket (mod_proxy_wstunnel dsb) ke REVERB_SERVER_HOST/PORT tempat
# proses `php artisan reverb:start` benar-benar listen. Wajib proses terpisah & persisten
# di hosting (bukan proses yang dimatikan tiap request seperti PHP-FPM biasa).
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=api.iron.shezaerp.net
REVERB_PORT=443
REVERB_SCHEME=https

REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080